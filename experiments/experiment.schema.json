{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMax-H3 Experiment",
  "type": "object",
  "required": ["id", "date", "category", "status", "sources", "conditions", "runs"],
  "properties": {
    "id": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "category": {
      "enum": [
        "01-baseline",
        "02-low-step-generation",
        "03-reference-conditioned",
        "04-acceleration",
        "05-temporal-continuity",
        "06-production-pipelines"
      ]
    },
    "status": {"enum": ["planned", "running", "verified", "partial", "failed"]},
    "hypothesis": {"type": "string"},
    "purpose": {"type": "string"},
    "scope": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "conditions": {"type": "object"},
    "runs": {"type": "array", "items": {"type": "object"}},
    "artifacts": {
      "anyOf": [
        {"type": "array", "items": {"type": "object"}},
        {"type": "object"}
      ]
    },
    "previews": {
      "type": "object",
      "properties": {
        "contactSheet": {"type": "string"},
        "manifest": {"type": "string"},
        "sourceVideos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "conclusion": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
