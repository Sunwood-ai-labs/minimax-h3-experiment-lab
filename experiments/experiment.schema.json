{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMax-H3 Experiment",
  "type": "object",
  "required": ["id", "date", "category", "status", "sources", "conditions", "runs", "previews", "publicEvidence", "publication"],
  "properties": {
    "id": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "category": {
      "enum": [
        "01-baseline",
        "02-low-step-generation",
        "03-reference-conditioned",
        "04-acceleration",
        "05-temporal-continuity",
        "06-production-pipelines"
      ]
    },
    "status": {"enum": ["planned", "running", "verified", "partial", "failed"]},
    "hypothesis": {"type": "string"},
    "purpose": {"type": "string"},
    "scope": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "conditions": {"type": "object"},
    "runs": {"type": "array", "items": {"type": "object"}},
    "artifacts": {
      "anyOf": [
        {"type": "array", "items": {"type": "object"}},
        {"type": "object"}
      ]
    },
    "previews": {
      "type": "object",
      "properties": {
        "contactSheet": {"type": "string"},
        "manifest": {"type": "string"},
        "sourceVideos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "publicEvidence": {
      "type": "object",
      "required": ["tile", "manifest", "videoStatus"],
      "properties": {
        "tile": {"type": "string"},
        "manifest": {"type": "string"},
        "videoStatus": {"enum": ["tracked", "local-only", "not-applicable"]},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "required": ["platform", "status", "videoTweets"],
      "properties": {
        "platform": {"const": "x"},
        "status": {"enum": ["posted", "uncertain", "simulation_only", "not_posted"]},
        "videoTweets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "runId": {"type": "string"},
              "url": {"type": "string", "pattern": "^https://x\\.com/[^/]+/status/[0-9]+"}
            },
            "additionalProperties": true
          }
        },
        "note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "conclusion": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
